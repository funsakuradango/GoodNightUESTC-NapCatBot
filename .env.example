TZ=Asia/Shanghai
UESTC_USERNAME=
UESTC_PASSWORD=
AUTH_SUCCESS_SELECTOR=button:has-text("未读通知")
TASK_TIMEOUT_SECONDS=300
PAGE_TIMEOUT_SECONDS=25
AUTH_WAIT_SECONDS=30

# Playwright built-in WGS84 geolocation. Both empty means no override.
GEO_LATITUDE=
GEO_LONGITUDE=
GEO_ACCURACY_METERS=30

# Public UESTC selectors observed in October 2026; verify after platform updates.
# Use a direct business URL OR an entry selector on the authenticated hall page.
CHECKIN_URL=
CHECKIN_ENTRY_SELECTOR='.app-text:text-is("晚安成电")'
# Optional iframe selector within the checkin page.
CHECKIN_FRAME_SELECTOR=
CHECKIN_PENDING_SELECTOR=
CHECKIN_COMPLETED_SELECTOR=
# Must point to the timestamp of TODAY'S verified record.
CHECKIN_TIME_SELECTOR=
CHECKIN_NOT_STARTED_SELECTOR=
CHECKIN_SUBMIT_SELECTOR='.check-in-circle:not(.disabled):not(.abnormalFlag):has-text("请打卡")'
# Optional DOM confirmation button, not a JS alert/confirm dialog.
CHECKIN_CONFIRM_SELECTOR='.wd-message-box:visible:has(.wd-message-box__title:text-is("确认打卡")) .wd-message-box__actions-btn >> nth=-1'
CHECKIN_ADAPTER=uestc
# UESTC: protocol authorization before a real submission. First run wechat-authorize.
WECHAT_TICKET_ENABLED=true
# Container default is /opt/wechat/bin/python3; keep empty/out of .env for Docker.
# WECHAT_PYTHON=
CHECKIN_ENABLED=false
CHECKIN_HOUR=21
CHECKIN_MINUTE=5

# OneBot HTTP API, NOT NapCat WebUI (6099). Leave both empty to disable notifications.
# Host Docker service on Mac: http://host.docker.internal:<actual-api-port>
# Shared Docker network: http://napcat:3000; set BOT_NETWORK to the existing network.
NAPCAT_HTTP_URL=
NAPCAT_TOKEN=
QQ_USER_ID=
BOT_NETWORK=
